# Copy to /opt/boutline/preview.env on the droplet (chmod 600).
#
# Shared by every boutline PR preview container. Only the database name, the
# hostname and the version differ per PR, and preview-up.sh passes those --
# which is why these secrets live on the droplet instead of crossing the wire
# on every deploy.

APP_ENVIRONMENT=preview
APP_PORT=8000

# The droplet's preview-only Postgres, on the `edge` network. Plaintext is
# fine: traffic never leaves the Docker bridge and the data is throwaway.
DB_HOST=preview-db
DB_PORT=5432
DB_USER=postgres
# Must match PREVIEW_DB_PASSWORD in /opt/shared/.env exactly.
DB_PASSWORD=
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=1

# Signs auth JWTs (HS256). Required in preview -- the backend refuses to
# start without it. At least 32 bytes; generate with `openssl rand -hex 32`.
# Must differ from JWT_SECRET in production's backend.env.
JWT_SECRET=
