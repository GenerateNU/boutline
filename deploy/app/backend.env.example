# Copy to /opt/boutline/backend.env on the droplet (chmod 600).
# Production configuration. Every key is listed in backend/README.md; DB_HOST,
# DB_NAME and the rest of DB_* are set by docker-compose.yml.

APP_ENVIRONMENT=production
APP_PORT=8000

# Browsers reach the API same-origin through Vercel, so CORS only matters for
# direct callers such as the /docs UI.
APP_ALLOWED_ORIGINS=https://boutline.vercel.app

# Initialises the boutline-db container on first start, and is what the backend
# and migrations connect with. Generate with `openssl rand -hex 32`: hex, since
# it is interpolated into a postgres:// URL where "/" or "+" would break it.
# Changing it later does NOT change the existing database's password.
DB_PASSWORD=
