# Copy to /opt/boutline/backend.env on the droplet (chmod 600).
# Production configuration. Every key is listed in backend/README.md.

APP_ENVIRONMENT=production
APP_PORT=8000

# Browsers reach the API same-origin through Vercel, so CORS only matters for
# direct callers such as the /docs UI.
APP_ALLOWED_ORIGINS=https://boutline.vercel.app

# Supabase production database, through the SESSION pooler (port 5432 on
# aws-0-<region>.pooler.supabase.com). The direct db.<ref>.supabase.co host is
# IPv6-only on the free plan and unreachable from a default Docker network; the
# transaction pooler (6543) breaks the prepared statements gorm relies on.
DB_HOST=
DB_PORT=5432
# Pooler usernames carry the project ref: postgres.<project-ref>
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL_MODE=require
# Session-mode pooler slots are shared by every project on the droplet.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
