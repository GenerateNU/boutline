    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "tailwindcss": "^4",
    "ts-node": "10.9.2",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.5",
